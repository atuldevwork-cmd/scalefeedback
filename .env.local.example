# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WIDGET_URL=http://localhost:5173

# Optional: Resend (email)
RESEND_API_KEY=re_your_key

# Optional: Slack OAuth (https://api.slack.com/apps → OAuth & Permissions, scope: incoming-webhook)
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret

# Optional: GitHub OAuth (https://github.com/settings/developers, scope: repo)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Optional: Jira OAuth (https://developer.atlassian.com/console/myapps/, scopes: read:jira-work write:jira-work)
JIRA_CLIENT_ID=your_jira_client_id
JIRA_CLIENT_SECRET=your_jira_client_secret

# Optional: ClickUp OAuth + two-way sync
# NEXT_PUBLIC_APP_URL must be publicly reachable for ClickUp webhooks (use ngrok in dev)
CLICKUP_CLIENT_ID=CLICKUP_CLIENT_ID
CLICKUP_CLIENT_SECRET=CLICKUP_CLIENT_SECRET
