# Supabase — same project as apps/dashboard/.env.local (copy the values from there)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Google PageSpeed Insights API (apps/worker/src/pagespeed.ts)
# Works without a key too, but unauthenticated calls share a small global
# quota across every keyless caller and get exhausted almost immediately —
# get a free key from https://console.cloud.google.com/apis/library/pagespeedonline.googleapis.com
# (Enable the API, then APIs & Services → Credentials → Create Credentials → API key)
PAGESPEED_API_KEY=your_pagespeed_api_key
OPENAI_API_KEY=XXXX_XXXX_DDD_RTY
PERPLEXITY_API_KEY=XXXX_XXXX_DDD_RTY
GOOGLE_AI_API_KEY=XXXX_XXXX_DDD_RTY
